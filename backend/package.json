{
  "name": "zammove-backend",
  "version": "1.0.0",
  "description": "ZamMove hauling and rental system: API server (business rules) and static host for the frontend",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed:demo": "node scripts/seed-demo.js",
    "reset-password": "node scripts/reset-password.js",
    "reset-data": "node scripts/reset-data.js",
    "create-driver": "node scripts/create-driver.js",
    "https-cert": "node scripts/https-cert.js",
    "test": "node --test \"test/*.test.js\""
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "dotenv": "16.4.5",
    "express": "4.22.3"
  }
}
