# Copy this file to .env and fill it in. Never commit .env.

# Port for the API and the frontend (http://localhost:3000/customer/)
PORT=3000

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=

# Supabase (Project Settings > API). The service-role key stays on the server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Storage: supabase | file | memory
# Leave empty to use Supabase when SUPABASE_URL is set, otherwise a local file (backend/.data/zammove.json).
STORE=

# Optional: require this code on the one-time #owner-setup page
OWNER_SETUP_CODE=

# NODE_ENV=production

# Optional HTTPS so phones on the same Wi-Fi can share GPS (browsers block location on plain http://).
# Fill these in automatically with: npm run https-cert
# HTTPS_KEY=
# HTTPS_CERT=
# HTTPS_PORT=3443
